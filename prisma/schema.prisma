// Autoservice — multi-tenant schema (SQLite for local demo; Postgres-ready)
// To switch to Postgres later: change provider to "postgresql" and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  STAFF
  CLIENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  posts         ServicePost[]
  bookings      Booking[]
  orders        Order[]
  customers     Customer[]
  vehicles      Vehicle[]
  services      Service[]
  workOrders    WorkOrder[]
  workOrderSeq  Int          @default(0)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  bookings    Booking[]    @relation("ClientBookings")
  orders      Order[]      @relation("ClientOrders")
  customers   Customer[]
}

model Membership {
  id             String   @id @default(cuid())
  role           Role
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Пост / бокс обслуживания
model ServicePost {
  id             String   @id @default(cuid())
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  workOrders   WorkOrder[]

  @@index([organizationId])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  postId         String?
  serviceName    String
  vehicleInfo    String?
  startsAt       DateTime
  durationMin    Int           @default(60)
  status         BookingStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       User         @relation("ClientBookings", fields: [clientId], references: [id])
  post         ServicePost? @relation(fields: [postId], references: [id])

  @@index([organizationId, startsAt])
  @@index([clientId])
  @@index([postId, startsAt])
}

/// Legacy stub history (kept for compatibility); ЛК prefers WorkOrder
model Order {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  title          String
  amountRub      Int
  completedAt    DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       User         @relation("ClientOrders", fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([clientId])
}

/// Клиент справочника (CRM), опционально привязан к User для ЛК
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicles     Vehicle[]
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, phone])
}

model Vehicle {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  make           String
  model          String
  plate          String
  year           Int?
  color          String?
  vin            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, plate])
}

/// Услуга прайс-листа
model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  priceRub       Int
  durationMin    Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        WorkOrderLine[]

  @@index([organizationId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  number         Int
  status         WorkOrderStatus @default(OPEN)
  customerId     String
  vehicleId      String
  postId         String?
  scheduledAt    DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id])
  post         ServicePost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  lines        WorkOrderLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([vehicleId])
  @@index([postId, scheduledAt])
}

model WorkOrderLine {
  id             String  @id @default(cuid())
  workOrderId    String
  serviceId      String?
  name           String
  priceRub       Int
  durationMin    Int
  quantity       Int     @default(1)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
}
