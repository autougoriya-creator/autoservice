// Autoservice — multi-tenant schema (SQLite for local demo; Postgres-ready)
// To switch to Postgres later: change provider to "postgresql" and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
  CLIENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderStatus {
  NEW
  NEW_FROM_CLIENT
  CONFIRMED
  IN_PROGRESS
  CLOSED
}

/// Вид оплаты заказ-наряда
enum PaymentMethod {
  CASH
  TERMINAL
  INVOICE
  CASH_AND_TERMINAL
}

enum PayMode {
  DEAL
  SALARY
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  posts           ServicePost[]
  bookings        Booking[]
  bookingLines    BookingLine[]
  orders          Order[]
  customers       Customer[]
  vehicles        Vehicle[]
  services        Service[]
  workOrders      WorkOrder[]
  staffProfiles   StaffProfile[]
  postAssignments PostAssignment[]
  staffShifts     StaffShift[]
  workOrderSeq    Int              @default(0)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  bookings      Booking[]      @relation("ClientBookings")
  orders        Order[]        @relation("ClientOrders")
  customers     Customer[]
  staffProfiles StaffProfile[]
}

model Membership {
  id             String   @id @default(cuid())
  role           Role
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Пост / бокс обслуживания
model ServicePost {
  id             String   @id @default(cuid())
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  workOrders      WorkOrder[]
  postAssignments PostAssignment[]
  staffShifts     StaffShift[]

  @@index([organizationId])
}

/// Профиль сотрудника (мойщик / слесарь) и настройки оплаты
model StaffProfile {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @default("Мойщик")
  payMode        PayMode  @default(DEAL)
  dealPercent    Int      @default(30)
  salaryRub      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  PostAssignment[]
  shifts       StaffShift[]

  @@unique([organizationId, userId])
  @@index([organizationId])
}

/// Закрепление сотрудника за постом
model PostAssignment {
  id             String    @id @default(cuid())
  organizationId String
  postId         String
  staffProfileId String
  activeFrom     DateTime  @default(now())
  activeTo       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         ServicePost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, postId])
  @@index([staffProfileId])
}

/// Смена / график сотрудника
model StaffShift {
  id             String   @id @default(cuid())
  organizationId String
  staffProfileId String
  postId         String?
  startsAt       DateTime
  endsAt         DateTime
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  post         ServicePost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([staffProfileId, startsAt])
}

model Booking {
  id               String        @id @default(cuid())
  organizationId   String
  clientId         String
  postId           String?
  /// Сводка услуг для списков / совместимости
  serviceName      String
  /// Плановая сумма записи, ₽ (из каталога, можно править)
  plannedAmountRub Int           @default(0)
  vehicleInfo      String?
  startsAt         DateTime
  durationMin      Int           @default(60)
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       User          @relation("ClientBookings", fields: [clientId], references: [id])
  post         ServicePost?  @relation(fields: [postId], references: [id])
  lines        BookingLine[]

  @@index([organizationId, startsAt])
  @@index([clientId])
  @@index([postId, startsAt])
}

/// Строка услуги в записи (план)
model BookingLine {
  id             String  @id @default(cuid())
  organizationId String
  bookingId      String
  serviceId      String?
  name           String
  priceRub       Int
  durationMin    Int     @default(30)
  quantity       Int     @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([organizationId])
}

/// Legacy stub history (kept for compatibility); ЛК prefers WorkOrder
model Order {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  title          String
  amountRub      Int
  completedAt    DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       User         @relation("ClientOrders", fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([clientId])
}

/// Клиент справочника (CRM): идентификатор = телефон (уникален в тенанте)
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  /// Нормализованный телефон — уникальный ID клиента в организации
  phone          String
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicles     Vehicle[]
  workOrders   WorkOrder[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, phone])
}

model Vehicle {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  make           String
  model          String
  plate          String
  year           Int?
  color          String?
  vin            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, plate])
}

/// Услуга прайс-листа
model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  priceRub       Int
  durationMin    Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        WorkOrderLine[]
  bookingLines BookingLine[]

  @@index([organizationId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  number         Int
  status         WorkOrderStatus @default(NEW)
  customerId     String
  vehicleId      String
  postId         String?
  scheduledAt    DateTime?
  notes          String?
  /// Вид оплаты при закрытии
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id])
  post         ServicePost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  lines        WorkOrderLine[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, paidAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([postId, scheduledAt])
}

model WorkOrderLine {
  id             String  @id @default(cuid())
  workOrderId    String
  serviceId      String?
  name           String
  priceRub       Int
  durationMin    Int
  quantity       Int     @default(1)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
}
