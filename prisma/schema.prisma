// Autoservice — multi-tenant schema (SQLite for local demo; Postgres-ready)
// To switch to Postgres later: change provider to "postgresql" and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  STAFF
  CLIENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkOrderStatus {
  NEW
  NEW_FROM_CLIENT
  CONFIRMED
  IN_PROGRESS
  CLOSED
}

/// Вид оплаты заказ-наряда
enum PaymentMethod {
  CASH
  TERMINAL
  INVOICE
  CASH_AND_TERMINAL
}

enum PayMode {
  DEAL
  SALARY
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  posts           ServicePost[]
  bookings        Booking[]
  bookingLines    BookingLine[]
  orders          Order[]
  customers       Customer[]
  vehicles        Vehicle[]
  services          Service[]
  workOrders        WorkOrder[]
  staffProfiles     StaffProfile[]
  postAssignments   PostAssignment[]
  staffShifts       StaffShift[]
  fluidSkus         FluidSku[]
  stockMovements    StockMovement[]
  serviceFluidNorms ServiceFluidNorm[]
  vehicleClasses    VehicleClass[]
  serviceClassPrices ServiceClassPrice[]
  workOrderSeq      Int              @default(0)
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  bookings       Booking[]      @relation("ClientBookings")
  orders         Order[]        @relation("ClientOrders")
  customers      Customer[]
  staffProfiles  StaffProfile[]
  stockMovements StockMovement[]
}

model Membership {
  id             String   @id @default(cuid())
  role           Role
  organizationId String
  userId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Пост / бокс обслуживания
model ServicePost {
  id             String   @id @default(cuid())
  name           String
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  workOrders      WorkOrder[]
  postAssignments PostAssignment[]
  staffShifts     StaffShift[]

  @@index([organizationId])
}

/// Профиль сотрудника (мойщик / слесарь) и настройки оплаты
model StaffProfile {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String   @default("Мойщик")
  payMode        PayMode  @default(DEAL)
  dealPercent    Int      @default(30)
  salaryRub      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments  PostAssignment[]
  shifts       StaffShift[]

  @@unique([organizationId, userId])
  @@index([organizationId])
}

/// Закрепление сотрудника за постом
model PostAssignment {
  id             String    @id @default(cuid())
  organizationId String
  postId         String
  staffProfileId String
  activeFrom     DateTime  @default(now())
  activeTo       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         ServicePost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)

  @@index([organizationId, postId])
  @@index([staffProfileId])
}

/// Смена / график сотрудника
model StaffShift {
  id             String   @id @default(cuid())
  organizationId String
  staffProfileId String
  postId         String?
  startsAt       DateTime
  endsAt         DateTime
  note           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfile StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  post         ServicePost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([staffProfileId, startsAt])
}

model Booking {
  id               String        @id @default(cuid())
  organizationId   String
  clientId         String
  postId           String?
  /// Сводка услуг для списков / совместимости
  serviceName      String
  /// Плановая сумма записи, ₽ (из каталога, можно править)
  plannedAmountRub Int           @default(0)
  vehicleInfo      String?
  startsAt         DateTime
  durationMin      Int           @default(60)
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       User          @relation("ClientBookings", fields: [clientId], references: [id])
  post         ServicePost?  @relation(fields: [postId], references: [id])
  lines        BookingLine[]

  @@index([organizationId, startsAt])
  @@index([clientId])
  @@index([postId, startsAt])
}

/// Строка услуги в записи (план)
model BookingLine {
  id             String  @id @default(cuid())
  organizationId String
  bookingId      String
  serviceId      String?
  name           String
  priceRub       Int
  durationMin    Int     @default(30)
  quantity       Int     @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([organizationId])
}

/// Legacy stub history (kept for compatibility); ЛК prefers WorkOrder
model Order {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  title          String
  amountRub      Int
  completedAt    DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       User         @relation("ClientOrders", fields: [clientId], references: [id])

  @@index([organizationId])
  @@index([clientId])
}

/// Клиент справочника (CRM): идентификатор = телефон (уникален в тенанте)
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  /// Нормализованный телефон — уникальный ID клиента в организации
  phone          String
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicles     Vehicle[]
  workOrders   WorkOrder[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, phone])
}

/// Класс / категория автомобиля (ценообразование)
model VehicleClass {
  id             String   @id @default(cuid())
  organizationId String
  /// Короткий код: 1, 2, 3…
  code           String
  name           String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  classPrices  ServiceClassPrice[]

  @@unique([organizationId, code])
  @@index([organizationId, sortOrder])
}

model Vehicle {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  vehicleClassId String?
  make           String
  model          String
  plate          String
  year           Int?
  color          String?
  vin            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleClass VehicleClass? @relation(fields: [vehicleClassId], references: [id], onDelete: SetNull)
  workOrders   WorkOrder[]

  @@index([organizationId])
  @@index([customerId])
  @@index([vehicleClassId])
  @@index([organizationId, plate])
}

/// Услуга прайс-листа
model Service {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Базовая цена, ₽ (если нет цены по классу)
  priceRub       Int
  /// Норма времени, мин
  durationMin    Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        WorkOrderLine[]
  bookingLines BookingLine[]
  fluidNorms   ServiceFluidNorm[]
  classPrices  ServiceClassPrice[]

  @@index([organizationId])
}

/// Цена услуги по классу автомобиля
model ServiceClassPrice {
  id             String @id @default(cuid())
  organizationId String
  serviceId      String
  vehicleClassId String
  priceRub       Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicleClass VehicleClass @relation(fields: [vehicleClassId], references: [id], onDelete: Cascade)

  @@unique([serviceId, vehicleClassId])
  @@index([organizationId])
  @@index([vehicleClassId])
}

/// Номенклатура техжидкостей (SKU склада)
model FluidSku {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Единица учёта: л, мл, шт
  unit           String   @default("л")
  skuCode        String?
  isActive       Boolean  @default(true)
  /// Остаток на складе (в единицах unit)
  quantityOnHand Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  serviceNorms ServiceFluidNorm[]

  @@index([organizationId])
  @@index([organizationId, name])
}

enum StockMovementType {
  RECEIPT
  CONSUMPTION
  INVENTORY
}

/// Движение склада: поступление / расход / инвентаризация
model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  fluidSkuId     String
  type           StockMovementType
  /// Изменение остатка (+ поступление, − расход; для инвентаризации = fact − was)
  quantityDelta  Float
  /// Остаток после операции
  quantityAfter  Float
  note           String?
  workOrderId    String?
  createdById    String?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fluidSku     FluidSku     @relation(fields: [fluidSkuId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?   @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([fluidSkuId, createdAt])
  @@index([workOrderId])
}

/// Норма расхода техжидкости на услугу (на 1 ед. услуги)
model ServiceFluidNorm {
  id              String @id @default(cuid())
  organizationId  String
  serviceId       String
  fluidSkuId      String
  quantityPerUnit Float

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fluidSku     FluidSku     @relation(fields: [fluidSkuId], references: [id], onDelete: Cascade)

  @@unique([serviceId, fluidSkuId])
  @@index([organizationId])
  @@index([fluidSkuId])
}

model WorkOrder {
  id             String          @id @default(cuid())
  organizationId String
  number         Int
  status         WorkOrderStatus @default(NEW)
  customerId     String
  vehicleId      String
  postId         String?
  scheduledAt    DateTime?
  notes          String?
  /// Вид оплаты при закрытии
  paymentMethod  PaymentMethod?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  completedAt    DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id])
  post           ServicePost?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  lines          WorkOrderLine[]
  stockMovements StockMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, paidAt])
  @@index([customerId])
  @@index([vehicleId])
  @@index([postId, scheduledAt])
}

model WorkOrderLine {
  id             String  @id @default(cuid())
  workOrderId    String
  serviceId      String?
  name           String
  priceRub       Int
  durationMin    Int
  quantity       Int     @default(1)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
}
